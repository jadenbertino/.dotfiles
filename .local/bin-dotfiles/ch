#!/bin/bash
set -euo pipefail

PORT="${CHROME_DEBUG_PORT:-9222}"
PROFILE="${CHROME_DEBUG_PROFILE:-$HOME/.chrome-debug}"
CHROME="${CHROME_BIN:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  echo "usage: ch [codespace-name]  (default: most recently used running codespace)"
  echo "Starts Chrome with remote debugging on :$PORT and reverse-tunnels it into a codespace in the background."
  exit 0
fi

if curl -s -m 1 "localhost:$PORT/json/version" >/dev/null; then
  echo "Chrome debug port already up on :$PORT"
else
  echo "Starting Chrome (profile: $PROFILE)"
  nohup "$CHROME" --remote-debugging-port="$PORT" --user-data-dir="$PROFILE" >/dev/null 2>&1 &
  for _ in {1..50}; do
    curl -s -m 1 "localhost:$PORT/json/version" >/dev/null && break
    sleep 0.2
  done
  curl -s -m 1 "localhost:$PORT/json/version" >/dev/null || { echo "Chrome didn't open :$PORT" >&2; exit 1; }
fi

codespace="${1:-$(gh codespace list --json name,state,lastUsedAt \
  --jq '[.[] | select(.state == "Available")] | sort_by(.lastUsedAt) | last | .name // empty')}"
[[ -n "$codespace" ]] || { echo "No running codespace found" >&2; exit 1; }

if pgrep -f "codespace ssh -c $codespace -- -R $PORT" >/dev/null; then
  echo "Tunnel into $codespace already running"
  exit 0
fi

log="/tmp/ch-$codespace.log"
(
  trap '' HUP
  gh codespace ssh -c "$codespace" -- \
    -R "$PORT:localhost:$PORT" -N \
    -o ExitOnForwardFailure=yes \
    -o ServerAliveInterval=30 || true
  echo "Tunnel exited at $(date)"
  state=$(gh codespace view -c "$codespace" --json state --jq .state 2>/dev/null || true)
  if [[ "$state" == Shutdown || "$state" == ShuttingDown ]] &&
    ! pgrep -f "codespace ssh -c .* -R $PORT" >/dev/null; then
    pkill -TERM -f -- "--user-data-dir=$PROFILE" && echo "Codespace $state; closed Chrome"
  else
    echo "Codespace state '$state' or other tunnels still running; left Chrome open"
  fi
) </dev/null >"$log" 2>&1 &
pid=$!

for _ in {1..5}; do
  kill -0 "$pid" 2>/dev/null || { echo "Tunnel exited; see $log" >&2; exit 1; }
  if gh codespace ssh -c "$codespace" -- curl -s -m 2 "localhost:$PORT/json/version" >/dev/null 2>&1; then
    echo "Started: :$PORT tunneled into $codespace (pid $pid, log $log)"
    exit 0
  fi
  sleep 1
done

echo "Tunnel still running but :$PORT isn't reachable in $codespace yet; see $log" >&2
exit 1
