#!/usr/bin/env bash
set -euo pipefail

api_names=(account auth assets storefront purchase checkout reports payouts subscriptions wallet status)
preview_base_url="https://neon-preview.readme.io"

usage() {
  echo "Usage: README_PREVIEW_API_KEY=<key> readme-preview [--apis=<api1,api2,...>]" >&2
  echo "Supported APIs: ${api_names[*]}" >&2
}

apis=""

for argument in "$@"; do
  case "$argument" in
    -h | --help)
      usage
      exit 0
      ;;
    --apis=*)
      if [[ -n "$apis" ]]; then
        echo "--apis can only be specified once" >&2
        exit 1
      fi
      apis="${argument#--apis=}"
      ;;
    *)
      echo "Unknown argument: $argument" >&2
      usage
      exit 1
      ;;
  esac
done

if [[ -n "$apis" ]]; then
  if [[ "$apis" == ,* || "$apis" == *, || "$apis" == *,,* ]]; then
    echo "--apis must be a comma-separated list without empty values" >&2
    exit 1
  fi

  IFS=, read -r -a selected_apis <<< "$apis"
  for api in "${selected_apis[@]}"; do
    supported=false
    for supported_api in "${api_names[@]}"; do
      if [[ "$api" == "$supported_api" ]]; then
        supported=true
        break
      fi
    done
    if [[ "$supported" == false ]]; then
      echo "Unknown API: $api" >&2
      usage
      exit 1
    fi
  done
fi

if [[ -z "${README_PREVIEW_API_KEY:-}" ]]; then
  echo "README_PREVIEW_API_KEY is required" >&2
  exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"
if [[ ! -d packages/apis/maker_api_docs ]]; then
  echo "readme-preview must be run from the Neon repository" >&2
  exit 1
fi
yarn openapi

declare -A spec_files=(
  [account]=AccountAPI.yml
  [auth]=AuthAPI.yml
  [assets]=AssetsAPI.yml
  [storefront]=StorefrontAPI.yml
  [purchase]=PurchaseAPI.yml
  [checkout]=CheckoutAPI.yml
  [reports]=ReportsAPI.yml
  [payouts]=PayoutAPI.yml
  [subscriptions]=SubscriptionsAPI.yml
  [wallet]=WalletAPI.yml
  [status]=StatusAPI.yml
)
declare -A slugs=(
  [account]=account-api
  [auth]=auth-api
  [assets]=assets-api
  [storefront]=storefront-api
  [purchase]=purchase-api
  [checkout]=checkout-api
  [reports]=reports-api
  [payouts]=payouts-api
  [subscriptions]=subscriptions-api
  [wallet]=wallet-api
  [status]=status-api
)

if [[ -z "$apis" ]]; then
  git fetch origin main
  changed_specs="$(git diff --name-only origin/main -- packages/apis/maker_api_docs | rg '^packages/apis/maker_api_docs/[^/]+API\.yml$' || true)"
  selected_apis=()

  for api in "${api_names[@]}"; do
    spec_path="packages/apis/maker_api_docs/${spec_files[$api]}"
    if rg -Fxq "$spec_path" <<< "$changed_specs"; then
      selected_apis+=("$api")
    fi
  done

  if [[ ${#selected_apis[@]} -eq 0 ]]; then
    echo "No changed API files found relative to origin/main"
    exit 0
  fi

  echo "Detected changed APIs: ${selected_apis[*]}"
fi

for api in "${selected_apis[@]}"; do
  spec="$repo_root/packages/apis/maker_api_docs/${spec_files[$api]}"
  upload_args=(
    "$spec"
    --key="$README_PREVIEW_API_KEY"
    --slug="${slugs[$api]}"
    --branch=stable
  )

  npx --yes rdme@10.9.6 openapi validate "$spec"
  npx --yes rdme@10.9.6 openapi upload "${upload_args[@]}" --confirm-overwrite

  operation_id="$(rg -m 1 '^\s+operationId:' "$spec" | sed -E 's/^\s*operationId:\s*//')"
  reference_slug="$(tr '[:upper:]' '[:lower:]' <<< "$operation_id")"
  echo "Preview URL for $api: $preview_base_url/reference/$reference_slug"
done
