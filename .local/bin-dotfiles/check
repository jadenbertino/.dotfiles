#!/usr/bin/env bash
# Format with Prettier, then run tsc-daemon + targeted ESLint on the provided files.
# Usage: check [--ts <5|7>] <file ...>

set -euo pipefail

ESLINT=/workspaces/neon/node_modules/eslint/bin/eslint.js
PRETTIER=/workspaces/neon/node_modules/prettier/bin/prettier.cjs
USAGE="Usage: check [--ts <5|7>] <file ...>"

ts_major=5
files=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --ts)
      if [[ $# -lt 2 ]]; then printf 'check: --ts requires a value\n%s\n' "$USAGE" >&2; exit 1; fi
      ts_major="${2%%.*}"; shift 2 ;;
    --ts=*) ts_major="${1#--ts=}"; ts_major="${ts_major%%.*}"; shift ;;
    *) files+=("$1"); shift ;;
  esac
done

case "$ts_major" in
  5)
    TSC=(node /workspaces/neon/node_modules/typescript/bin/tsc)
    TSC_HINT="run yarn install in the repo" ;;
  7)
    TSC=("${TSC_DAEMON_TYPESCRIPT:-$HOME/.local/share/typescript7}/node_modules/.bin/tsc")
    TSC_HINT="run install.sh from your dotfiles" ;;
  *)
    printf 'check: unsupported TypeScript version %s\n%s\n' "$ts_major" "$USAGE" >&2
    exit 1 ;;
esac

if [[ ${#files[@]} -eq 0 ]]; then
  echo "$USAGE" >&2
  exit 1
fi

eslint_out=$(mktemp)
tsc_out=$(mktemp)
prettier_out=$(mktemp)
trap 'rm -f "$eslint_out" "$tsc_out" "$prettier_out"' EXIT

# Format before analysing, so ESLint and tsc see the final text and CI's format
# job can't fail on something that was already fixable here. A prettier failure
# means the file doesn't parse — tsc says that better, so report and carry on.
if ! node "$PRETTIER" --ignore-unknown --write "${files[@]}" >"$prettier_out" 2>&1; then
  cat "$prettier_out" >&2
fi

find_tsconfig() {
  local file dir
  file=$(realpath "$1")
  if [[ -d "$file" ]]; then
    dir="$file"
  else
    dir=$(dirname "$file")
  fi

  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/tsconfig.json" ]]; then
      printf '%s/tsconfig.json\n' "$dir"
      return 0
    fi
    dir=$(dirname "$dir")
  done

  return 1
}

fallback_tsc() {
  local configs=()
  local file config

  for file in "$@"; do
    if config=$(find_tsconfig "$file"); then
      configs+=("$config")
    fi
  done

  if [[ ${#configs[@]} -eq 0 ]]; then
    printf 'check: could not find a tsconfig.json for the provided files\n' >&2
    return 1
  fi

  mapfile -t configs < <(printf '%s\n' "${configs[@]}" | sort -u)

  if [[ ! -f "${TSC[-1]}" ]]; then
    printf 'check: TypeScript %s not found at %s — %s\n' "$ts_major" "${TSC[-1]}" "$TSC_HINT" >&2
    return 1
  fi

  : >"$tsc_out"
  for config in "${configs[@]}"; do
    "${TSC[@]}" \
      -p "$config" \
      --noEmit \
      --pretty false >>"$tsc_out" 2>&1 || true
  done

  if [[ -s "$tsc_out" ]]; then
    cat "$tsc_out"
    return 1
  fi

  return 0
}

tsc-daemon --ts "$ts_major" "${files[@]}" >"$tsc_out" 2>&1 &
tsc_pid=$!

# ESLint is slow on the first run: projectService: true forces TypeScript to
# load the full project type graph regardless of how few files are passed.
# --cache makes subsequent runs near-instant for unchanged files.
node "$ESLINT" --cache "${files[@]}" >"$eslint_out" 2>&1 &
eslint_pid=$!

# Poll until one process exits, then react. Unlike the FIFO approach, running
# both tools directly (not in subshells) gives us their real PIDs so kill and
# wait work correctly.
tsc_done=false
eslint_done=false

while ! $tsc_done || ! $eslint_done; do
  if ! $tsc_done && ! kill -0 "$tsc_pid" 2>/dev/null; then
    tsc_done=true
    if ! wait "$tsc_pid"; then
      if grep -q 'daemon failed to start within 30s' "$tsc_out"; then
        fallback_tsc "${files[@]}" || { kill "$eslint_pid" 2>/dev/null || true; exit 1; }
      else
        kill "$eslint_pid" 2>/dev/null || true
        cat "$tsc_out"
        exit 1
      fi
    fi
  fi
  if ! $eslint_done && ! kill -0 "$eslint_pid" 2>/dev/null; then
    eslint_done=true
    wait "$eslint_pid" || { kill "$tsc_pid" 2>/dev/null || true; cat "$eslint_out"; exit 1; }
  fi
  $tsc_done && $eslint_done || sleep 0.05
done
