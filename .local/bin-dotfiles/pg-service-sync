#!/bin/bash
set -e

if ! command -v doppler &> /dev/null; then
  echo "[pg-service-sync] doppler is not installed, skipping"
  exit 0
fi

if ! command -v jq &> /dev/null; then
  echo "[pg-service-sync] jq is not installed, skipping"
  exit 0
fi

PROJECT="${1:-pg}"
CONFIG_PREFIX="${2:-prd_}"
SERVICE_FILE="$HOME/.pg_service.conf"
PGPASS_FILE="$HOME/.pgpass"

echo "[pg-service-sync] syncing database configs from doppler project '$PROJECT' (prefix: $CONFIG_PREFIX)..."

# Get all configs in the project with the specified prefix
CONFIGS=$(doppler configs --project "$PROJECT" --json 2>/dev/null | jq -r '.[] | select(.name | startswith("'$CONFIG_PREFIX'")) | .name')

if [ -z "$CONFIGS" ]; then
  echo "[pg-service-sync] no configs found with prefix '$CONFIG_PREFIX'"
  exit 1
fi

# Start building the service file
SERVICE_TMP="$SERVICE_FILE.tmp"
> "$SERVICE_TMP"  # Clear/create temp file

# Start building pgpass file (preserve manual entries)
PGPASS_TMP="$PGPASS_FILE.tmp"
PGPASS_MARKER="# MANAGED BY pg-service-sync - DO NOT EDIT BELOW THIS LINE"

# Copy existing manual entries (everything before the marker)
if [ -f "$PGPASS_FILE" ]; then
  sed "/$PGPASS_MARKER/q" "$PGPASS_FILE" 2>/dev/null | grep -v "$PGPASS_MARKER" > "$PGPASS_TMP" || true
fi

# Add marker and header
cat >> "$PGPASS_TMP" << EOF
$PGPASS_MARKER
# Auto-synced from Doppler project '$PROJECT' (configs: $CONFIG_PREFIX*)
# Last synced: $(date -u +"%Y-%m-%d %H:%M:%S UTC")
EOF

# Add header to service file
cat >> "$SERVICE_TMP" << EOF
# PostgreSQL Service Connection File
# Auto-generated by pg-service-sync from Doppler
# DO NOT EDIT MANUALLY - changes will be overwritten
# Last synced: $(date -u +"%Y-%m-%d %H:%M:%S UTC")

EOF

# Process each config
SYNCED_COUNT=0
while IFS= read -r config; do
  echo "[pg-service-sync] processing config: $config"

  # Download secrets for this config
  SECRETS=$(doppler secrets download \
    --no-file \
    --format env \
    --project "$PROJECT" \
    --config "$config" 2>/dev/null)

  # Extract PG variables
  PGNAME=$(echo "$SECRETS" | grep "^PGNAME=" | cut -d'=' -f2- | tr -d '"' || echo "")
  PGHOST=$(echo "$SECRETS" | grep "^PGHOST=" | cut -d'=' -f2- | tr -d '"' || echo "")
  PGPORT=$(echo "$SECRETS" | grep "^PGPORT=" | cut -d'=' -f2- | tr -d '"' || echo "5432")
  PGDATABASE=$(echo "$SECRETS" | grep "^PGDATABASE=" | cut -d'=' -f2- | tr -d '"' || echo "")
  PGUSER=$(echo "$SECRETS" | grep "^PGUSER=" | cut -d'=' -f2- | tr -d '"' || echo "")
  PGPASSWORD=$(echo "$SECRETS" | grep "^PGPASSWORD=" | cut -d'=' -f2- | tr -d '"' || echo "")

  # Check for missing required fields
  MISSING_FIELDS=()
  [ -z "$PGNAME" ] && MISSING_FIELDS+=("PGNAME")
  [ -z "$PGHOST" ] && MISSING_FIELDS+=("PGHOST")
  [ -z "$PGDATABASE" ] && MISSING_FIELDS+=("PGDATABASE")
  [ -z "$PGUSER" ] && MISSING_FIELDS+=("PGUSER")
  [ -z "$PGPASSWORD" ] && MISSING_FIELDS+=("PGPASSWORD")

  if [ ${#MISSING_FIELDS[@]} -gt 0 ]; then
    echo "[pg-service-sync] skipping $config: missing required fields: ${MISSING_FIELDS[*]}"
    continue
  fi

  SERVICE_NAME="$PGNAME"

  # Write service entry to pg_service.conf
  cat >> "$SERVICE_TMP" << EOF
[$SERVICE_NAME]
host=$PGHOST
port=$PGPORT
dbname=$PGDATABASE
user=$PGUSER

EOF

  # Write password entry to .pgpass if password exists
  if [ -n "$PGPASSWORD" ]; then
    # Format: hostname:port:database:username:password
    echo "$PGHOST:$PGPORT:$PGDATABASE:$PGUSER:$PGPASSWORD" >> "$PGPASS_TMP"
  fi

  SYNCED_COUNT=$((SYNCED_COUNT + 1))

done <<< "$CONFIGS"

# Atomic move for pg_service.conf
chmod 600 "$SERVICE_TMP"
mv "$SERVICE_TMP" "$SERVICE_FILE"

# Atomic move for .pgpass
chmod 600 "$PGPASS_TMP"
mv "$PGPASS_TMP" "$PGPASS_FILE"

echo "[pg-service-sync] ✓ synced $SYNCED_COUNT service(s) to $SERVICE_FILE"
echo "[pg-service-sync] ✓ synced passwords to $PGPASS_FILE"
echo ""
echo "Available services:"
grep "^\[" "$SERVICE_FILE" | tr -d '[]'
echo ""
echo "Connect with: psql service=<name>"
