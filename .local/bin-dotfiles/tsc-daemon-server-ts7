#!/usr/bin/env node
// Persistent TypeScript 7 daemon.
// Keeps one tsgo API server alive so repeated file checks reuse its parsed programs.
// Usage: node tsc-daemon-server <socket-path>

import net from 'node:net';
import { existsSync, readFileSync, unlinkSync } from 'node:fs';
import path from 'node:path';

const [, , socketPath] = process.argv;
if (!socketPath) { process.stderr.write('Usage: tsc-daemon-server <socket-path>\n'); process.exit(1); }

const TS_HOME = process.env['TSC_DAEMON_TYPESCRIPT'] ?? path.join(process.env['HOME'], '.local/share/typescript7');
const API_ENTRY = path.join(TS_HOME, 'node_modules/typescript/dist/api/sync/api.js');

if (!existsSync(API_ENTRY)) {
  process.stderr.write(
    `tsc-daemon-server: TypeScript 7 not found at ${TS_HOME}.\n` +
    `Run \`install.sh\` from your dotfiles, or: (cd ${TS_HOME} && npm install)\n`,
  );
  process.exit(1);
}

const { API, DiagnosticCategory } = await import(API_ENTRY);

const CATEGORY_LABELS = {
  [DiagnosticCategory.Warning]: 'warning',
  [DiagnosticCategory.Error]: 'error',
  [DiagnosticCategory.Suggestion]: 'suggestion',
  [DiagnosticCategory.Message]: 'message',
};

const TS_VERSION = JSON.parse(readFileSync(path.join(TS_HOME, 'node_modules/typescript/package.json'), 'utf-8')).version;

let api;
const getApi = () => (api ??= new API({ cwd: process.cwd() }));
const resetApi = () => { try { api?.close(); } catch {} api = undefined; };

// Large batches of open files have crashed the tsgo pipe (EPIPE/EBADF), so files are
// checked in chunks and a failed chunk gets one retry on a fresh API instance.
const CHUNK_SIZE = 50;

const position = (program, diag) => {
  if (!diag.fileName) return '';
  const sourceFile = program.getSourceFile(diag.fileName);
  if (!sourceFile) return '';
  const { line, character } = sourceFile.getLineAndCharacterOfPosition(diag.pos);
  return `(${line + 1},${character + 1})`;
};

const format = (program, diag, indent = '') => {
  const label = CATEGORY_LABELS[diag.category] ?? 'error';
  const lines = [`${indent}${diag.fileName ?? ''}${position(program, diag)}: ${label} TS${diag.code}: ${diag.text}`];

  const chain = (entries, depth) => {
    for (const entry of entries ?? []) {
      lines.push(`${'  '.repeat(depth)}${entry.text}`);
      chain(entry.messageChain, depth + 1);
    }
  };
  chain(diag.messageChain, 1);

  for (const related of diag.relatedInformation ?? []) lines.push(format(program, related, '  '));
  return lines.join('\n');
};

const checkChunk = (files) => {
  let output = '';
  const api = getApi();
  const snapshot = api.updateSnapshot({ openFiles: files, fileChanges: { invalidateAll: true } });
  try {
    for (const file of files) {
      const project = snapshot.getDefaultProjectForFile(file);
      if (!project) continue;
      const { program } = project;
      const diags = [...program.getSyntacticDiagnostics(file), ...program.getSemanticDiagnostics(file)];
      for (const diag of diags) output += `${format(program, diag)}\n`;
    }
  } finally {
    snapshot.dispose();
    api.updateSnapshot({ closeFiles: files }).dispose();
  }
  return output;
};

const check = (files) => {
  const missing = files.filter((f) => !existsSync(f));
  const present = files.filter((f) => existsSync(f));
  let output = missing.map((f) => `error: file not found: ${f}\n`).join('');

  for (let i = 0; i < present.length; i += CHUNK_SIZE) {
    const chunk = present.slice(i, i + CHUNK_SIZE);
    try {
      output += checkChunk(chunk);
    } catch {
      resetApi();
      output += checkChunk(chunk);
    }
  }

  return { output, hasErrors: output.length > 0, checked: present.length };
};

const startedAt = new Date().toISOString();

// Auto-exit after 30 min idle to avoid stale memory.
const IDLE_MS = 30 * 60 * 1000;
let idleTimer;
const resetIdle = () => {
  clearTimeout(idleTimer);
  idleTimer = setTimeout(() => { try { unlinkSync(socketPath); } catch {} process.exit(0); }, IDLE_MS);
};

try { unlinkSync(socketPath); } catch {}

net.createServer((conn) => {
  resetIdle();
  let buf = '';
  conn.on('data', (d) => {
    buf += d;
    const nl = buf.indexOf('\n');
    if (nl === -1) return;
    const line = buf.slice(0, nl);
    buf = buf.slice(nl + 1);

    let req;
    try { req = JSON.parse(line); } catch { conn.end('{"ok":false,"error":"bad json"}\n'); return; }

    if (req.type === 'ping') { conn.end('{"ok":true,"type":"pong"}\n'); return; }
    if (req.type === 'shutdown') { conn.end('{"ok":true,"type":"bye"}\n', shutdown); return; }
    if (req.type !== 'check') { conn.end('{"ok":false,"error":"unknown type"}\n'); return; }

    try {
      conn.end(JSON.stringify({ ok: true, ...check(req.files), tsVersion: TS_VERSION, startedAt }) + '\n');
    } catch (e) {
      resetApi();
      conn.end(JSON.stringify({ ok: false, error: String(e) }) + '\n');
    }
  });
}).listen(socketPath, () => {
  process.stdout.write('ready\n');
  resetIdle();
});

function shutdown() {
  resetApi();
  try { unlinkSync(socketPath); } catch {}
  process.exit(0);
}
process.on('SIGTERM', shutdown);
