node_modules

# Ignore files in .ssh except `*.md` & `config`
.ssh/**/*
!.ssh/**/*.md
!.ssh/**/config_defaults
!.ssh/**/*.zsh

# Ignore .env files
.env*
!.env*.example

# Ignore tmux plugins (these are usually git repos)
.config/tmux/plugins

.local/share

.cursor
!.cursor/mcp.json

# claude
.claude/**/*
!.claude/AGENTS.md
!.claude/CLAUDE.md
!.claude/keybindings.json
!.claude/commands
!.claude/commands/**
!.claude/skills
!.claude/skills/**
!.claude/settings.json
!.claude/statusline-command.sh

.local/bin/claude
.claude-ntfy

.serena