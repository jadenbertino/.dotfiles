{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.local/bin-dotfiles/notify ] && ~/.local/bin-dotfiles/notify"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x ~/.local/bin-dotfiles/notify ] && ~/.local/bin-dotfiles/notify --permission"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {},
  "voiceEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754007386922
  }
}
